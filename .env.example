# Secret used only by POST /api/internal/refresh-sources.
# Generate a long random value in production and configure the same value as
# the GitHub repository secret SOURCE_REFRESH_SECRET.
SOURCE_REFRESH_SECRET=
# Origini browser aggiuntive autorizzate a chiamare il server MCP, separate da virgole.
# I client MCP server-side normalmente non inviano Origin e non richiedono questa variabile.
MCP_ALLOWED_ORIGINS=
# Host pubblici autorizzati per /api/mcp, separati da virgole e senza schema.
# Su Vercel vengono inclusi automaticamente anche i domini VERCEL_URL.
MCP_ALLOWED_HOSTS=

# Token fornito da OpenAI durante la verifica del dominio per la directory Apps.
# Se assente o non valido, la route challenge risponde 404.
OPENAI_APPS_CHALLENGE_TOKEN=

# GitHub App usata da POST /api/segnalazioni per creare le issue del pulsante
# «Segnala un problema». Installala solo su questo repository con il solo
# permesso Issues: Read and write. Se una variabile manca, l'endpoint risponde
# 503 e il modulo propone il composer GitHub precompilato.
REPORT_GITHUB_APP_ID=
REPORT_GITHUB_INSTALLATION_ID=
# Chiave privata PEM dell'App; su Vercel può essere incollata con i newline
# letterali oppure con \n escapati.
REPORT_GITHUB_APP_PRIVATE_KEY=

# Optional free assistant. Server only; never NEXT_PUBLIC_. Leave empty to disable.
REGOLO_API_KEY=
ASSISTANT_QUOTA_SECRET=
ASSISTANT_SUPABASE_URL=
ASSISTANT_SUPABASE_SECRET_KEY=

# Optional Resend (transactional email). Already used or planned for Auth Boards;
# never NEXT_PUBLIC_. See docs/DVNS_BOARDS.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# DVNS Boards Auth + storage (second Supabase project, distinct from ASSISTANT_*).
# Server only; never NEXT_PUBLIC_. See docs/DVNS_BOARDS.md.
# Session cookies always need BOARDS_AUTH_SECRET (>= 32 chars).
# Cloud OTP + sync + share need URL + anon + secret key; expose schema boards_private in PostgREST.
BOARDS_AUTH_SECRET=
BOARDS_SUPABASE_URL=
BOARDS_SUPABASE_ANON_KEY=
BOARDS_SUPABASE_SECRET_KEY=
# Optional Boards From override. Default: DVNS Boards <boards@same-domain-as-RESEND_FROM_EMAIL>.
BOARDS_RESEND_FROM_EMAIL=
# Optional inbox for Segnala problema / feedback (default: gagliardidomenico46@gmail.com).
BOARDS_FEEDBACK_TO=
