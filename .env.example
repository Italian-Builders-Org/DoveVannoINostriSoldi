# Secret used only by POST /api/internal/refresh-sources.
# Generate a long random value in production and configure the same value as
# the GitHub repository secret SOURCE_REFRESH_SECRET.
SOURCE_REFRESH_SECRET=
# Origini browser aggiuntive autorizzate a chiamare il server MCP, separate da virgole.
# I client MCP server-side normalmente non inviano Origin e non richiedono questa variabile.
MCP_ALLOWED_ORIGINS=
# Host pubblici autorizzati per /api/mcp, separati da virgole e senza schema.
# Su Vercel vengono inclusi automaticamente anche i domini VERCEL_URL.
MCP_ALLOWED_HOSTS=
# Chiave Resend per le richieste di consulenza (https://resend.com/api-keys).
# Senza questa variabile il form risponde 503 e invita a scrivere all'inbox.
RESEND_API_KEY=
# Destinatario delle lead. Se vuoto si usa gagliardidomenico46@gmail.com.
LEAD_INBOX_EMAIL=
# Mittente Resend. Senza un dominio verificato usa beth.t@example.com
# e può scrivere solo all'email dell'account Resend.
RESEND_FROM_EMAIL=
