{
  "name": "dove-vanno-i-nostri-soldi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Dati pubblici italiani spiegati in modo semplice, verificabile e open source.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "brand:generate": "node scripts/brand/generate-icons.mjs",
    "brand:check": "node scripts/brand/generate-icons.mjs --check",
    "readme:screenshots": "node scripts/brand/capture-readme.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "design:check": "impeccable detect src/",
    "ci:static": "npm run lint && npm run typecheck && npm run design:check && npm run brand:check",
    "ci:action-pins": "node scripts/ci/check-action-pins.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:node": "node --experimental-strip-types --test tests/*.test.mjs",
    "government-scorecard:verify": "python3 scripts/ci/check-government-scorecard-artifacts.py && node --experimental-strip-types --test tests/government-scorecard-*.test.mjs",
    "test:etl": "python3 -m unittest discover -s tests/etl -p 'test_*.py'",
    "test:snapshots": "python3 scripts/ci/validate-generated-artifacts.py --run-checks",
    "company-atlas:refresh": "node scripts/etl/company_atlas_snapshot.mjs",
    "education-atlas:refresh": "python3 scripts/etl/education_atlas_snapshot.py",
    "test:company-atlas": "node --experimental-strip-types --test tests/company-atlas.test.mjs",
    "test:education-atlas": "node --experimental-strip-types --test tests/education-atlas.test.mjs",
    "test:production": "bash scripts/ci/run-production-gates.sh",
    "bench:runtime": "node --experimental-strip-types scripts/bench/runtime.mjs",
    "test:browser:core": "node scripts/browser/core.mjs",
    "test:browser:editorial": "node --experimental-strip-types scripts/browser/editorial.mjs",
    "test:browser:report": "node scripts/browser/report.mjs",
    "test:csp:report-only": "node scripts/browser/csp-report-only.mjs",
    "test:browser:e2e": "node scripts/browser/core.mjs",
    "test:browser:integrated": "node --experimental-strip-types scripts/browser/editorial.mjs",
    "test:lighthouse": "node scripts/lighthouse_budget.mjs",
    "test:mcp:http": "node scripts/mcp_http_smoke.mjs",
    "test:mcp:load": "node scripts/mcp_load.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/server": "^2.0.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.2",
    "impeccable": "3.6.0",
    "lighthouse": "^13.4.1",
    "puppeteer": "^25.8.0",
    "typescript": "^5.9.0",
    "yaml": "2.9.0"
  }
}
