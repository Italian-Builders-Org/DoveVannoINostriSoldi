  "private": true,
  "type": "module",
  "description": "Dati pubblici italiani spiegati in modo semplice, verificabile e open source.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "brand:generate": "node scripts/brand/generate-icons.mjs",
