    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser:e2e": "node scripts/browser_e2e.mjs",
    "test:lighthouse": "node scripts/lighthouse_budget.mjs",
    "test:mcp:http": "node scripts/mcp_http_smoke.mjs",
